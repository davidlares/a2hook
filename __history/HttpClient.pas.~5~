unit HttpClient;

interface

procedure SendEvent(
  const TableName, KeyField, KeyValue, Operation: string
);

function JsonEscape(const S: string): string;

implementation

uses SysUtils, Classes, IdHTTP, Logger;

function TTriggerHook.JsonEscape(const S: string): string;
begin
  Result := S;
  Result := StringReplace(Result, '\', '\\', [rfReplaceAll]);
  Result := StringReplace(Result, '"', '\"', [rfReplaceAll]);
  Result := StringReplace(Result, #8, '\b', [rfReplaceAll]);
  Result := StringReplace(Result, #9, '\t', [rfReplaceAll]);
  Result := StringReplace(Result, #10, '\n', [rfReplaceAll]);
  Result := StringReplace(Result, #12, '\f', [rfReplaceAll]);
  Result := StringReplace(Result, #13, '\r', [rfReplaceAll]);
end;

procedure SendEvent(
  const TableName, KeyField, KeyValue, Operation: string
);
var
  Body: TStringStream;
  HTTP: TIdHTTP;
  Json: string;
begin
  Json :=
    '{' +
      '"timestamp":"' + JsonEscape(FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', Now)) + '",' +
      '"operation":"' + JsonEscape(Operation) + '",' +
      '"table":"' + JsonEscape(TableName) + '",' +
      '"keyField":"' + JsonEscape(KeyField) + '",' +
      '"keyValue":"' + JsonEscape(KeyValue) + '"' +
    '}';
  // writing JSON to log
  WriteLog('JSON: ' + Json);
  // HTTP  client                        
  HTTP := TIdHTTP.Create(nil);
  try
    HTTP.Request.ContentType := 'application/json';
    HTTP.ConnectTimeout := 3000;
    HTTP.ReadTimeout := 3000;
    // stream body
    Body := TStringStream.Create(UTF8Encode(Json));
    try
      HTTP.Post('http://127.0.0.1:3000/api/db-trigger', Body);
    finally
      Body.Free;
    end;
  except
    on E: Exception do
      WriteLog('SendEvent HTTP ERROR: ' + E.ClassName + ': ' + E.Message);
  end;

  HTTP.Free;
end;


end.
